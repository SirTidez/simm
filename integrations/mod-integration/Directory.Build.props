<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RepositoryUrl>https://github.com/SirTidez/simm</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>LockWire Labs and SIMM contributors</Authors>
    <Copyright>LockWire Labs and SIMM contributors</Copyright>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Simm.ModIntegration.Bridge.MelonLoader'">
    <RuntimeBackend Condition="'$(RuntimeBackend)' == ''">IL2CPP</RuntimeBackend>
    <BaseIntermediateOutputPath>obj/$(RuntimeBackend)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(RuntimeBackend)/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
