{
  "name": "simmrust",
  "private": true,
  "version": "0.8.2",
  "author": "LockWire Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/SirTidez/simm.git"
  },
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:playwright": "node scripts/tauri-playwright-dev.mjs",
    "test": "vitest run",
    "test:services": "vitest run src/services/**/*.test.ts",
    "test:components": "vitest run src/components/**/*.test.tsx",
    "test:stores": "vitest run src/stores/**/*.test.tsx",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:live": "cargo test --manifest-path src-tauri/Cargo.toml -- --ignored"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mlvscan/wasm-core": "^1.3.8",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-dialog": "2.7.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "2.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "esbuild": "^0.28.0",
    "jsdom": "^29.0.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
