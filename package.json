{
  "name": "simmrust",
  "private": true,
  "version": "0.8.6",
  "author": "LockWire Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/SirTidez/simm.git"
  },
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:scan": "vite --mode react-scan",
    "doctor": "react-doctor . --offline --fail-on none",
    "doctor:verbose": "react-doctor . --verbose --offline --fail-on none",
    "doctor:json": "react-doctor . --json --offline --fail-on none",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev:linux": "WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 tauri dev",
    "tauri:dev:linux:x11": "GDK_BACKEND=x11 WINIT_X11_SCALE_FACTOR=1 WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 tauri dev",
    "tauri:build:linux": "NO_STRIP=1 tauri build --bundles deb,appimage",
    "tauri:build:linux:appimage": "NO_STRIP=1 tauri build --bundles appimage",
    "tauri:build:linux:deb": "tauri build --bundles deb",
    "tauri:validate:linux-mime": "bash scripts/validate-linux-desktop-mime.sh",
    "tauri:validate:windows-manifest": "bash scripts/validate-windows-app-manifest.sh",
    "tauri:scan": "bun --env-file=.env.react-scan run tauri dev",
    "tauri:playwright": "node scripts/tauri-playwright-dev.mjs",
    "test": "vitest run",
    "test:services": "vitest run src/services/**/*.test.ts",
    "test:components": "vitest run src/components/**/*.test.tsx",
    "test:stores": "vitest run src/stores/**/*.test.tsx",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:live": "cargo test --manifest-path src-tauri/Cargo.toml -- --ignored",
    "test:linux-parity": "bash scripts/validate-linux-parity-smoke.sh",
    "test:release": "python .codex/skills/simmrust-release-updater/scripts/test_check_release_artifacts.py && pwsh -NoProfile -File .codex/skills/simmrust-release-updater/scripts/test_generate_updater_manifest.ps1 && pwsh -NoProfile -File scripts/test-windows-release-contract.ps1"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mlvscan/wasm-core": "^1.3.8",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-dialog": "2.7.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@uiw/react-codemirror": "^4.25.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@react-scan/vite-plugin-react-scan": "^0.2.6",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.0.2",
    "react-doctor": "^0.0.47",
    "react-scan": "^0.5.6",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
